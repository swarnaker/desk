# Server-only environment. Never put API keys in client code. Do not commit real secrets.
# If ROBINHOOD_RPC_URL / BITQUERY_API_KEY / BASE_RPC_URL / O1_API_KEY are unset,
# those adapters stay OFF and report an honest health miss (attempts >= 1, hits = 0,
# ok = false, detail = not wired). Factory stage is never faked on Dex-only rows.
# The Pons graduated catalog is public and does not need a key.

# DexScreener REST root (public). Default used if empty: https://api.dexscreener.com
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# Robinhood Chain (4663) JSON-RPC. Required to harvest Pons TokenLaunched factory events.
ROBINHOOD_RPC_URL=

# Bitquery API key. Optional fallback for Pons factory if ROBINHOOD_RPC_URL is unset.
BITQUERY_API_KEY=

# Base (8453) JSON-RPC. Required to harvest o1 factory launches.
BASE_RPC_URL=

# Solana JSON-RPC. Optional. Pump discovery uses DexScreener; leave empty to keep Sol factory off.
SOLANA_RPC_URL=

# o1 Launchpad API key (header x-api-key). Required for GET api.launch.o1.exchange/v1/tokens
# on chain 8453 and 4663. Unset = miss not wired, zero invented o1 launches.
O1_API_KEY=

# Optional Telegram notify for watched BIRTH/WAKE. Server-only. Never NEXT_PUBLIC_*.
# Unset = skip send, radar health "telegram not wired". Empty placeholders only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Single admin login. Server-only. Never NEXT_PUBLIC_*. Set in .env.local, never commit.
ADMIN_USER=
ADMIN_PASSWORD=
